# Kopiera till .env i den här katalogen och fyll i.
# Redan satta miljövariabler vinner över filen.

# --- Loops (loops.so) ---
# Settings → API → API key. Krävs för skarp körning (inte för --dry-run).
LOOPS_API_KEY=

# --- Notion (bara för --source notion) ---
# Internal integration token från notion.so/my-integrations.
# Kom ihåg att bjuda in integrationen till databasen: ⋯ → Connections.
NOTION_TOKEN=

# Databas-id för "Gymnasieskolor i Stockholms län".
# Finns i databasens URL: notion.so/<workspace>/<DATABAS-ID>?v=...
NOTION_DATABASE_ID=7dd2dd25c62e44faa33edf8e37e709ac

# Valfritt: Notion-API-version. Standard 2022-06-28.
# NOTION_VERSION=2022-06-28
